{
  "id": "ai2_source_freshness_probe",
  "kind": "freshness",
  "domain": "ai2",
  "purpose": "Check RSS, sitemap, developer docs, policy pages, and platform freshness before AI/2 fetch and scout work.",
  "inputs": [
    "2/index.html",
    "artifacts/ai2/claims.jsonl",
    "artifacts/ai2/evidence.jsonl"
  ],
  "outputs": [
    "source_freshness.json",
    "changed_sources.jsonl",
    "feed_health.json"
  ],
  "agents": [
    "source_freshness_monitor",
    "source_registry_router",
    "source_prompt_injection_guard",
    "no_freshness_without_fetch_guard"
  ],
  "gates": [
    "freshness_probe_completed",
    "source_health_recorded"
  ],
  "timeout_minutes": 12,
  "retry_policy": {
    "max_attempts": 2,
    "backoff_seconds": [
      60,
      180
    ]
  },
  "evidence_contract": {
    "min_sources_per_core_claim": 1,
    "min_sources_for_mutable_claim": 2,
    "max_staleness_days": 3,
    "freshness_fields": [
      "retrieved_at_utc",
      "etag",
      "page_hash"
    ]
  },
  "fail_closed_fields": [
    "freshness_probe"
  ],
  "page": "ai2",
  "prompt_file": "",
  "kst_slot": "01:50 KST",
  "runs_codex": false
}
